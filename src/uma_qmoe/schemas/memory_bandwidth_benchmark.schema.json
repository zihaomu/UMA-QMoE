{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/memory_bandwidth_benchmark.schema.json",
  "title": "UMA-QMoE MemoryBandwidthBenchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "target_id",
    "status",
    "measurement_scope",
    "runtime",
    "configuration",
    "memory",
    "operations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "memory_bandwidth_benchmark" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$" },
    "status": { "const": "passed" },
    "measurement_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_time", "traffic", "counter_calibrated", "limitations"],
      "properties": {
        "elapsed_time": { "const": "host_monotonic_with_device_synchronize" },
        "traffic": { "const": "algorithmic_bytes" },
        "counter_calibrated": { "const": false },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "torch",
        "cuda",
        "hip",
        "accelerator_name",
        "compute_capability"
      ],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "torch": { "type": "string", "minLength": 1 },
        "cuda": { "type": ["string", "null"] },
        "hip": { "type": ["string", "null"] },
        "accelerator_name": { "type": "string", "minLength": 1 },
        "compute_capability": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_buffer_bytes",
        "actual_buffer_bytes",
        "dtype",
        "element_count",
        "warmup_iterations",
        "measured_iterations"
      ],
      "properties": {
        "requested_buffer_bytes": { "type": "integer", "minimum": 4194304 },
        "actual_buffer_bytes": { "type": "integer", "minimum": 4194304 },
        "dtype": { "const": "float32" },
        "element_count": { "type": "integer", "minimum": 1048576 },
        "warmup_iterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "measured_iterations": { "type": "integer", "minimum": 3, "maximum": 100 },
        "inner_iterations": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_before_allocation_bytes",
        "total_bytes",
        "free_after_allocation_bytes",
        "peak_allocated_bytes",
        "peak_reserved_bytes"
      ],
      "properties": {
        "free_before_allocation_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 1 },
        "free_after_allocation_bytes": { "type": "integer", "minimum": 0 },
        "peak_allocated_bytes": { "type": "integer", "minimum": 0 },
        "peak_reserved_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider", "collection_mode", "samples"],
      "properties": {
        "status": { "const": "available" },
        "provider": { "enum": ["nvidia_smi", "amd_smi"] },
        "collection_mode": { "const": "sample_boundaries_outside_timed_region" },
        "samples": {
          "type": "array",
          "minItems": 6,
          "maxItems": 600,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "sample_index",
              "boundary",
              "monotonic_ns",
              "temperature_c",
              "socket_power_w",
              "graphics_clock_mhz",
              "memory_clock_mhz",
              "utilization_percent"
            ],
            "properties": {
              "operation_id": { "enum": ["read_reduce", "write_fill", "copy"] },
              "sample_index": { "type": "integer", "minimum": 0, "maximum": 99 },
              "boundary": { "enum": ["before", "after"] },
              "monotonic_ns": { "type": "integer", "minimum": 1 },
              "temperature_c": { "type": ["number", "null"], "minimum": -100 },
              "socket_power_w": { "type": ["number", "null"], "minimum": 0 },
              "graphics_clock_mhz": { "type": ["number", "null"], "minimum": 0 },
              "memory_clock_mhz": { "type": ["number", "null"], "minimum": 0 },
              "utilization_percent": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "implementation",
          "algorithmic_read_bytes",
          "algorithmic_write_bytes",
          "algorithmic_total_bytes",
          "samples_seconds",
          "median_seconds",
          "mean_seconds",
          "coefficient_of_variation",
          "effective_gbps"
        ],
        "properties": {
          "id": { "enum": ["read_reduce", "write_fill", "copy"] },
          "implementation": { "type": "string", "minLength": 1 },
          "algorithmic_read_bytes": { "type": "integer", "minimum": 0 },
          "algorithmic_write_bytes": { "type": "integer", "minimum": 0 },
          "algorithmic_total_bytes": { "type": "integer", "minimum": 1 },
          "samples_seconds": {
            "type": "array",
            "minItems": 3,
            "maxItems": 100,
            "items": { "type": "number", "exclusiveMinimum": 0 }
          },
          "median_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "mean_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "coefficient_of_variation": { "type": "number", "minimum": 0 },
          "effective_gbps": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
