{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "captured_at", "target_id", "status", "model", "kernel", "workload", "correctness", "performance", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "packed_q4_kernel_evidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "target_id": { "enum": ["halo3", "spark1"] },
    "status": { "enum": ["passed", "failed"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_revision", "expert_pack_sha256"],
      "properties": {
        "model_id": { "const": "allenai/OLMoE-1B-7B-0125" },
        "model_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "expert_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "device_name", "source_sha256", "abi", "compiled_for_target", "reads_packed_weights_directly", "full_dequantized_weight_cache"],
      "properties": {
        "platform": { "enum": ["hip_gfx1151", "cuda_sm121"] },
        "device_name": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "abi": { "enum": ["q4-group128-packed-u8-fp32-scale-bf16-in-bf16-out-v1", "q4-group128-packed-u8-fp32-scale-bf16-in-bf16-out-fused-moe-v2"] },
        "execution_strategy": { "const": "two-launch-gate-up-swiglu-down-route" },
        "compiled_for_target": { "type": "boolean" },
        "reads_packed_weights_directly": { "type": "boolean" },
        "full_dequantized_weight_cache": { "type": "boolean" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_index", "tokens", "top_k", "unique_experts", "warmup_iterations", "measured_iterations"],
      "properties": {
        "layer_index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "tokens": { "type": "integer", "minimum": 1 },
        "top_k": { "const": 8 },
        "unique_experts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "warmup_iterations": { "type": "integer", "minimum": 1 },
        "measured_iterations": { "type": "integer", "minimum": 3 }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_results", "moe_forward", "acceptance"],
      "properties": {
        "projection_results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "shape", "finite", "max_absolute_error", "cosine_similarity"],
            "properties": {
              "name": { "enum": ["gate_proj", "up_proj", "down_proj"] },
              "shape": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
              "finite": { "type": "boolean" },
              "max_absolute_error": { "type": "number", "minimum": 0 },
              "cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 }
            }
          }
        },
        "moe_forward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finite", "max_absolute_error", "cosine_similarity", "output_sha256"],
          "properties": {
            "finite": { "type": "boolean" },
            "max_absolute_error": { "type": "number", "minimum": 0 },
            "cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 },
            "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_absolute_error", "minimum_cosine_similarity"],
          "properties": {
            "max_absolute_error": { "type": "number", "minimum": 0 },
            "minimum_cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "samples_milliseconds", "median_milliseconds", "p95_milliseconds", "compressed_cache_tensor_count", "compressed_cache_bytes", "dequantized_weight_cache_bytes", "formal_tps_claim"],
      "properties": {
        "scope": { "const": "single_moe_layer_microbenchmark" },
        "samples_milliseconds": { "type": "array", "minItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "median_milliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "p95_milliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "compressed_cache_tensor_count": { "type": "integer", "minimum": 3 },
        "compressed_cache_bytes": { "type": "integer", "minimum": 1 },
        "dequantized_weight_cache_bytes": { "const": 0 },
        "formal_tps_claim": { "const": false }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_architecture", "target_compilation", "direct_packed_input", "no_dequantized_weight_cache", "projection_correctness", "moe_correctness", "performance_mode_executed", "overall_passed"],
      "properties": {
        "target_architecture": { "type": "boolean" },
        "target_compilation": { "type": "boolean" },
        "direct_packed_input": { "type": "boolean" },
        "no_dequantized_weight_cache": { "type": "boolean" },
        "projection_correctness": { "type": "boolean" },
        "moe_correctness": { "type": "boolean" },
        "performance_mode_executed": { "type": "boolean" },
        "overall_passed": { "type": "boolean" }
      }
    }
  }
}
