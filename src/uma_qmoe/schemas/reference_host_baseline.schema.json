{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/reference_host_baseline.schema.json",
  "title": "UMA-QMoE ReferenceHostBaseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "generated_at", "target_id", "status",
    "implementation", "model", "workload", "results", "memory",
    "telemetry", "raw_artifacts", "gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "reference_host_baseline" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$" },
    "status": { "enum": ["passed", "failed"] },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source_commit", "backend", "container_image", "torch_version", "transformers_version", "backend_version"],
      "properties": {
        "name": { "const": "pytorch_hf_reference_host" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "backend": { "enum": ["cuda", "hip"] },
        "container_image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$" },
        "torch_version": { "type": "string", "minLength": 1 },
        "transformers_version": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 }
      }
    },
    "model": { "$ref": "#/$defs/model" },
    "workload": { "$ref": "#/$defs/workload" },
    "results": { "$ref": "#/$defs/results" },
    "memory": { "$ref": "#/$defs/memory" },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "raw_artifacts": {
      "type": "array", "minItems": 2,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "runner_succeeded", "all_requests_completed", "no_request_errors",
        "exact_input_length", "exact_output_length", "throughput_consistent",
        "manual_cache_decode", "offline_local_model", "overall_passed"
      ],
      "properties": {
        "runner_succeeded": { "type": "boolean" },
        "all_requests_completed": { "type": "boolean" },
        "no_request_errors": { "type": "boolean" },
        "exact_input_length": { "type": "boolean" },
        "exact_output_length": { "type": "boolean" },
        "throughput_consistent": { "type": "boolean" },
        "manual_cache_decode": { "const": true },
        "offline_local_model": { "const": true },
        "overall_passed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision", "weight_dtype", "derivation_semantic_sha256"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "weight_dtype": { "const": "BF16" },
        "derivation_semantic_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "warmup_requests", "measured_requests", "max_concurrency", "decoding", "ignore_eos", "seed"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 2 },
        "warmup_requests": { "type": "integer", "minimum": 1 },
        "measured_requests": { "type": "integer", "minimum": 3 },
        "max_concurrency": { "const": 1 },
        "decoding": { "const": "greedy" },
        "ignore_eos": { "const": true },
        "seed": { "const": 0 }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_seconds", "completed_requests", "failed_requests", "total_input_tokens", "total_output_tokens", "request_throughput", "output_token_throughput", "total_token_throughput", "ttft_ms", "tpot_ms", "e2el_ms"],
      "properties": {
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "completed_requests": { "type": "integer", "minimum": 0 },
        "failed_requests": { "type": "integer", "minimum": 0 },
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "request_throughput": { "type": "number", "minimum": 0 },
        "output_token_throughput": { "type": "number", "minimum": 0 },
        "total_token_throughput": { "type": "number", "minimum": 0 },
        "ttft_ms": { "$ref": "#/$defs/summary" },
        "tpot_ms": { "$ref": "#/$defs/summary" },
        "e2el_ms": { "$ref": "#/$defs/summary" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["mean", "p50", "p95", "p99", "max"],
      "properties": {
        "mean": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "peak_bytes", "torch_peak_allocated_bytes", "torch_peak_reserved_bytes"],
      "properties": {
        "scope": { "const": "workload_cgroup" },
        "peak_bytes": { "type": "integer", "minimum": 1 },
        "torch_peak_allocated_bytes": { "type": "integer", "minimum": 0 },
        "torch_peak_reserved_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_count", "maximum_temperature_c", "maximum_socket_power_w", "minimum_memory_available_bytes"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "maximum_temperature_c": { "type": ["number", "null"] },
        "maximum_socket_power_w": { "type": ["number", "null"] },
        "minimum_memory_available_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
