{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/tensor_inventory.schema.json",
  "title": "UMA-QMoE TensorInventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "model_manifest_sha256",
    "tensor_payload_hash_algorithm",
    "shards",
    "tensor_count",
    "observed_dtypes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "tensor_inventory" },
    "generated_at": { "type": "string", "format": "date-time" },
    "model_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tensor_payload_hash_algorithm": { "const": "sha256" },
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shard" }
    },
    "tensor_count": { "type": "integer", "minimum": 1 },
    "observed_dtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "file_sha256", "tensors"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tensors": {
          "type": "array",
          "items": { "$ref": "#/$defs/tensor" }
        }
      }
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "offset_bytes",
        "size_bytes",
        "payload_sha256"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "dtype": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "offset_bytes": { "type": "integer", "minimum": 0 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
