{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/allocation_matrix.schema.json",
  "title": "UMA-QMoE AllocationMatrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "target_id",
    "status",
    "measurement_scope",
    "runtime",
    "configuration",
    "memory",
    "system_activity",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "allocation_matrix" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$" },
    "status": { "const": "diagnostic" },
    "measurement_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_time", "traffic", "limitations"],
      "properties": {
        "elapsed_time": { "const": "host_monotonic_with_device_synchronize" },
        "traffic": { "const": "algorithmic_bytes" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "torch", "cuda", "hip", "accelerator_name"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "torch": { "type": "string", "minLength": 1 },
        "cuda": { "type": ["string", "null"] },
        "hip": { "type": ["string", "null"] },
        "accelerator_name": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_buffer_bytes",
        "actual_buffer_bytes",
        "dtype",
        "element_count",
        "warmup_iterations",
        "measured_iterations",
        "host_page_size_bytes"
      ],
      "properties": {
        "requested_buffer_bytes": { "type": "integer", "minimum": 4194304 },
        "actual_buffer_bytes": { "type": "integer", "minimum": 4194304 },
        "dtype": { "const": "float32" },
        "element_count": { "type": "integer", "minimum": 1048576 },
        "warmup_iterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "measured_iterations": { "type": "integer", "minimum": 3, "maximum": 100 },
        "host_page_size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free_device_before_bytes", "total_device_bytes", "free_device_after_bytes"],
      "properties": {
        "free_device_before_bytes": { "type": "integer", "minimum": 0 },
        "total_device_bytes": { "type": "integer", "minimum": 1 },
        "free_device_after_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "system_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swap_in_pages_delta", "swap_out_pages_delta"],
      "properties": {
        "swap_in_pages_delta": { "type": ["integer", "null"], "minimum": 0 },
        "swap_out_pages_delta": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "allocation_api", "access_path"],
        "properties": {
          "id": {
            "enum": [
              "runtime_device_copy",
              "host_pageable_h2d",
              "host_pinned_h2d",
              "host_pinned_d2h",
              "file_mmap_pretouched_h2d",
              "managed_unified",
              "platform_vmm_hmm"
            ]
          },
          "status": { "enum": ["measured", "unavailable", "not_measured"] },
          "allocation_api": { "type": "string", "minLength": 1 },
          "access_path": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "measurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allocation_seconds",
              "pretouch_seconds",
              "payload_bytes",
              "algorithmic_read_bytes",
              "algorithmic_write_bytes",
              "first_access",
              "steady_state",
              "page_faults"
            ],
            "properties": {
              "allocation_seconds": { "type": "number", "minimum": 0 },
              "pretouch_seconds": { "type": ["number", "null"], "minimum": 0 },
              "payload_bytes": { "type": "integer", "minimum": 1 },
              "algorithmic_read_bytes": { "type": "integer", "minimum": 1 },
              "algorithmic_write_bytes": { "type": "integer", "minimum": 1 },
              "first_access": { "$ref": "#/$defs/accessMeasurement" },
              "steady_state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "samples_seconds",
                  "median_seconds",
                  "p95_seconds",
                  "mean_seconds",
                  "coefficient_of_variation",
                  "payload_gbps",
                  "algorithmic_total_gbps"
                ],
                "properties": {
                  "samples_seconds": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 100,
                    "items": { "type": "number", "exclusiveMinimum": 0 }
                  },
                  "median_seconds": { "type": "number", "exclusiveMinimum": 0 },
                  "p95_seconds": { "type": "number", "exclusiveMinimum": 0 },
                  "mean_seconds": { "type": "number", "exclusiveMinimum": 0 },
                  "coefficient_of_variation": { "type": "number", "minimum": 0 },
                  "payload_gbps": { "type": "number", "exclusiveMinimum": 0 },
                  "algorithmic_total_gbps": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              "page_faults": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "first_access_minor_delta",
                  "first_access_major_delta",
                  "steady_state_minor_delta",
                  "steady_state_major_delta"
                ],
                "properties": {
                  "first_access_minor_delta": { "type": "integer", "minimum": 0 },
                  "first_access_major_delta": { "type": "integer", "minimum": 0 },
                  "steady_state_minor_delta": { "type": "integer", "minimum": 0 },
                  "steady_state_major_delta": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "accessMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seconds", "payload_gbps", "algorithmic_total_gbps"],
      "properties": {
        "seconds": { "type": "number", "exclusiveMinimum": 0 },
        "payload_gbps": { "type": "number", "exclusiveMinimum": 0 },
        "algorithmic_total_gbps": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
