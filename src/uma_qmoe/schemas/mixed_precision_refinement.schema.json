{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/mixed_precision_refinement.schema.json",
  "title": "UMA-QMoE MixedPrecisionRefinement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "captured_at", "target_id", "status", "model", "method", "reference", "all_q4_baseline", "storage", "cumulative_layer_rows", "layer2_expert_rows", "layer2_expert_ranking", "quality_gate", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "mixed_precision_refinement" },
    "captured_at": { "type": "string", "format": "date-time" },
    "target_id": { "enum": ["halo3", "spark1"] },
    "status": { "enum": ["passed", "failed"] },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_revision", "expert_pack_sha256"],
      "properties": {
        "model_id": { "const": "allenai/OLMoE-1B-7B-0125" },
        "model_revision": { "const": "9b0c1aa87e34a20052389dce1f0cf01da783f654" },
        "expert_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "diagnostic_only", "materializes_expert_parameters", "performance_evidence", "source_single_layer_evidence", "layer_order", "expert_layer"],
      "properties": {
        "id": { "const": "cumulative-layer-and-layer2-expert-bf16-restore-v1" },
        "diagnostic_only": { "const": true },
        "materializes_expert_parameters": { "const": true },
        "performance_evidence": { "const": false },
        "source_single_layer_evidence": { "$ref": "#/$defs/identity" },
        "layer_order": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "integer", "minimum": 0, "maximum": 15 }, "uniqueItems": true },
        "expert_layer": { "const": 2 }
      }
    },
    "reference": { "$ref": "#/$defs/capture" },
    "all_q4_baseline": { "$ref": "#/$defs/metrics" },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["all_q4_bytes", "total_expert_weight_count", "layer2_q4_bytes", "layer2_bf16_bytes"],
      "properties": {
        "all_q4_bytes": { "type": "integer", "minimum": 1 },
        "total_expert_weight_count": { "type": "integer", "minimum": 1 },
        "layer2_q4_bytes": { "type": "integer", "minimum": 1 },
        "layer2_bf16_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "cumulative_layer_rows": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["added_layer", "restored_layers", "metrics", "delta_vs_all_q4", "mixed_bytes", "effective_bpw", "finite"],
        "properties": {
          "added_layer": { "type": "integer", "minimum": 0, "maximum": 15 },
          "restored_layers": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "integer", "minimum": 0, "maximum": 15 }, "uniqueItems": true },
          "metrics": { "$ref": "#/$defs/metrics" },
          "delta_vs_all_q4": { "$ref": "#/$defs/delta" },
          "mixed_bytes": { "type": "integer", "minimum": 1 },
          "effective_bpw": { "type": "number", "exclusiveMinimum": 0 },
          "finite": { "type": "boolean" }
        }
      }
    },
    "layer2_expert_rows": {
      "type": "array", "minItems": 64, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["restored_expert", "reference_route_count", "q4_route_count", "metrics", "delta_vs_all_q4", "extra_bytes", "finite"],
        "properties": {
          "restored_expert": { "type": "integer", "minimum": 0, "maximum": 63 },
          "reference_route_count": { "type": "integer", "minimum": 0 },
          "q4_route_count": { "type": "integer", "minimum": 0 },
          "metrics": { "$ref": "#/$defs/metrics" },
          "delta_vs_all_q4": { "$ref": "#/$defs/delta" },
          "extra_bytes": { "type": "integer", "minimum": 1 },
          "finite": { "type": "boolean" }
        }
      }
    },
    "layer2_expert_ranking": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "type": "integer", "minimum": 0, "maximum": 63 }, "uniqueItems": true },
    "quality_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_router_exact_set_agreement", "first_passing_restored_layers"],
      "properties": {
        "minimum_router_exact_set_agreement": { "const": 0.99 },
        "first_passing_restored_layers": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "integer", "minimum": 0, "maximum": 15 }, "uniqueItems": true }
          ]
        }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_finite", "all_q4_finite", "layer2_first", "all_layers_covered", "all_layer2_experts_covered", "matrix_finite", "quality_gate_unchanged", "overall_passed"],
      "properties": {
        "reference_finite": { "type": "boolean" },
        "all_q4_finite": { "type": "boolean" },
        "layer2_first": { "type": "boolean" },
        "all_layers_covered": { "type": "boolean" },
        "all_layer2_experts_covered": { "type": "boolean" },
        "matrix_finite": { "type": "boolean" },
        "quality_gate_unchanged": { "type": "boolean" },
        "overall_passed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["file_sha256", "semantic_sha256"],
      "properties": {
        "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "semantic_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["finite", "logits_sha256", "routes_sha256", "top1_token_id"],
      "properties": {
        "finite": { "type": "boolean" },
        "logits_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "routes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "top1_token_id": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["finite", "top1_token_id", "top1_matches_reference", "logit_max_absolute_error", "logit_p99_absolute_error", "logit_cosine_similarity", "router_exact_set_agreement", "router_mean_set_overlap", "per_layer_router_exact_set_agreement"],
      "properties": {
        "finite": { "type": "boolean" },
        "top1_token_id": { "type": "integer", "minimum": 0 },
        "top1_matches_reference": { "type": "boolean" },
        "logit_max_absolute_error": { "type": "number", "minimum": 0 },
        "logit_p99_absolute_error": { "type": "number", "minimum": 0 },
        "logit_cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 },
        "router_exact_set_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "router_mean_set_overlap": { "type": "number", "minimum": 0, "maximum": 1 },
        "per_layer_router_exact_set_agreement": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "delta": {
      "type": "object", "additionalProperties": false,
      "required": ["router_exact_set_agreement", "router_mean_set_overlap", "logit_cosine_similarity"],
      "properties": {
        "router_exact_set_agreement": { "type": "number", "minimum": -1, "maximum": 1 },
        "router_mean_set_overlap": { "type": "number", "minimum": -1, "maximum": 1 },
        "logit_cosine_similarity": { "type": "number", "minimum": -2, "maximum": 2 }
      }
    }
  }
}
