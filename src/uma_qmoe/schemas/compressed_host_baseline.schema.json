{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/compressed_host_baseline.schema.json",
  "title": "UMA-QMoE CompressedHostBaseline v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "target_id", "status", "implementation", "model", "workload", "results", "loader", "backend_cache", "memory", "resource_policy", "telemetry", "raw_artifacts", "gates"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "kind": { "const": "compressed_host_baseline" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_id": { "enum": ["halo3", "spark1"] },
    "status": { "enum": ["passed", "failed"] },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source_commit", "backend", "platform", "container_image", "torch_version", "transformers_version", "backend_version", "native_source_sha256", "fallback_count"],
      "properties": {
        "name": { "const": "uma_qmoe_compressed_host" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "backend": { "enum": ["cuda", "hip"] },
        "platform": { "enum": ["cuda_sm121", "hip_gfx1151"] },
        "container_image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$" },
        "torch_version": { "type": "string", "minLength": 1 },
        "transformers_version": { "type": "string", "minLength": 1 },
        "backend_version": { "type": "string", "minLength": 1 },
        "native_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fallback_count": { "const": 0 }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision", "dense_weight_dtype", "expert_quantization", "expert_pack_sha256"],
      "properties": {
        "model_id": { "const": "allenai/OLMoE-1B-7B-0125" },
        "revision": { "const": "9b0c1aa87e34a20052389dce1f0cf01da783f654" },
        "dense_weight_dtype": { "const": "BF16" },
        "expert_quantization": { "enum": ["canonical_q4_group128", "mixed_target_pack_q4_q8_bf16"] },
        "expert_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "target_policy_id": { "const": "olmoe-layer15-awq-q4-q8-bf16-v2" }
      }
    },
    "workload": { "$ref": "#/$defs/workload" },
    "results": { "$ref": "#/$defs/results" },
    "loader": {
      "type": "object", "additionalProperties": false,
      "required": ["performance_mode", "dense_tensor_count", "dense_tensor_bytes", "skipped_expert_tensor_count", "loaded_expert_tensor_count", "expert_parameter_count", "quantized_moe_block_count", "model_parameter_bytes", "expert_pack_size_bytes", "expert_pack_mapping_count", "expert_pack_vma_count"],
      "properties": {
        "performance_mode": { "const": true },
        "dense_tensor_count": { "type": "integer", "minimum": 1 },
        "dense_tensor_bytes": { "type": "integer", "minimum": 1 },
        "skipped_expert_tensor_count": { "const": 3072 },
        "loaded_expert_tensor_count": { "const": 0 },
        "expert_parameter_count": { "const": 0 },
        "quantized_moe_block_count": { "const": 16 },
        "model_parameter_bytes": { "type": "integer", "minimum": 1 },
        "expert_pack_size_bytes": { "type": "integer", "minimum": 1 },
        "expert_pack_mapping_count": { "const": 1 },
        "expert_pack_vma_count": { "enum": [-1, 1] }
      }
    },
    "backend_cache": {
      "type": "object", "additionalProperties": false,
      "required": ["after_warmup", "after_measurement"],
      "properties": {
        "after_warmup": { "$ref": "#/$defs/cache" },
        "after_measurement": { "$ref": "#/$defs/cache" }
      }
    },
    "memory": { "$ref": "#/$defs/memory" },
    "resource_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["safe_uma_budget_bytes"],
      "properties": {
        "safe_uma_budget_bytes": { "const": 34359738368 }
      }
    },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "raw_artifacts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/artifact" } },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_succeeded", "all_requests_completed", "no_request_errors", "exact_input_length", "exact_output_length", "throughput_consistent", "manual_cache_decode", "offline_local_model", "packed_backend_registered", "performance_mode_executed", "no_silent_fallback", "cache_stable_after_warmup", "no_dequantized_weight_cache", "dense_only_checkpoint_load", "no_expert_parameters", "single_pack_mapping", "within_safe_uma_budget", "overall_passed"],
      "properties": {
        "runner_succeeded": { "type": "boolean" },
        "all_requests_completed": { "type": "boolean" },
        "no_request_errors": { "type": "boolean" },
        "exact_input_length": { "type": "boolean" },
        "exact_output_length": { "type": "boolean" },
        "throughput_consistent": { "type": "boolean" },
        "manual_cache_decode": { "const": true },
        "offline_local_model": { "const": true },
        "packed_backend_registered": { "type": "boolean" },
        "performance_mode_executed": { "type": "boolean" },
        "no_silent_fallback": { "type": "boolean" },
        "cache_stable_after_warmup": { "type": "boolean" },
        "no_dequantized_weight_cache": { "type": "boolean" },
        "dense_only_checkpoint_load": { "type": "boolean" },
        "no_expert_parameters": { "type": "boolean" },
        "single_pack_mapping": { "type": "boolean" },
        "within_safe_uma_budget": { "type": "boolean" },
        "overall_passed": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } } },
      "then": {
        "properties": {
          "model": {
            "properties": {
              "expert_quantization": { "const": "canonical_q4_group128" }
            },
            "not": { "required": ["target_policy_id"] }
          }
        }
      },
      "else": {
        "properties": {
          "model": {
            "required": ["target_policy_id"],
            "properties": {
              "expert_quantization": { "const": "mixed_target_pack_q4_q8_bf16" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "warmup_requests", "measured_requests", "max_concurrency", "decoding", "ignore_eos", "seed"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 1 },
        "output_tokens": { "type": "integer", "minimum": 2 },
        "warmup_requests": { "type": "integer", "minimum": 1 },
        "measured_requests": { "type": "integer", "minimum": 3 },
        "max_concurrency": { "const": 1 },
        "decoding": { "const": "greedy" },
        "ignore_eos": { "const": true },
        "seed": { "const": 0 }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_seconds", "completed_requests", "failed_requests", "total_input_tokens", "total_output_tokens", "request_throughput", "output_token_throughput", "total_token_throughput", "ttft_ms", "tpot_ms", "e2el_ms"],
      "properties": {
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "completed_requests": { "type": "integer", "minimum": 0 },
        "failed_requests": { "type": "integer", "minimum": 0 },
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "request_throughput": { "type": "number", "minimum": 0 },
        "output_token_throughput": { "type": "number", "minimum": 0 },
        "total_token_throughput": { "type": "number", "minimum": 0 },
        "ttft_ms": { "$ref": "#/$defs/summary" },
        "tpot_ms": { "$ref": "#/$defs/summary" },
        "e2el_ms": { "$ref": "#/$defs/summary" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["mean", "p50", "p95", "p99", "max"],
      "properties": {
        "mean": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["tensor_count", "device_storage_bytes", "dequantized_weight_bytes"],
      "properties": {
        "tensor_count": { "type": "integer", "minimum": 1, "maximum": 3072 },
        "device_storage_bytes": { "type": "integer", "minimum": 1 },
        "dequantized_weight_bytes": { "const": 0 }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "peak_bytes", "torch_peak_allocated_bytes", "torch_peak_reserved_bytes"],
      "properties": {
        "scope": { "const": "workload_cgroup" },
        "peak_bytes": { "type": "integer", "minimum": 1 },
        "torch_peak_allocated_bytes": { "type": "integer", "minimum": 0 },
        "torch_peak_reserved_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_count", "maximum_temperature_c", "maximum_socket_power_w", "minimum_memory_available_bytes"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1 },
        "maximum_temperature_c": { "type": ["number", "null"] },
        "maximum_socket_power_w": { "type": ["number", "null"] },
        "minimum_memory_available_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
