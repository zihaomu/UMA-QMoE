{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/hardware_counter_calibration.schema.json",
  "title": "UMA-QMoE HardwareCounterCalibration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "generated_at",
    "target_id",
    "status",
    "native_source",
    "profile",
    "configuration",
    "excluded_dispatches",
    "calibrations",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "hardware_counter_calibration" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$" },
    "status": { "enum": ["passed", "failed"] },
    "native_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "backend", "architecture", "file_name", "file_bytes", "file_sha256"],
      "properties": {
        "tool": { "const": "rocprofv3" },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 },
        "backend": { "const": "hip" },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 128 },
        "file_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "file_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "file_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_bytes_per_dispatch", "maximum_relative_error", "profiled_dispatches_per_operation"],
      "properties": {
        "known_bytes_per_dispatch": { "type": "integer", "minimum": 4194304 },
        "maximum_relative_error": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "profiled_dispatches_per_operation": { "type": "integer", "minimum": 3, "maximum": 10000 }
      }
    },
    "excluded_dispatches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dispatch_id", "operation", "reason"],
        "properties": {
          "dispatch_id": { "type": "integer", "minimum": 0 },
          "operation": { "const": "write" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "direction",
          "counter_name",
          "bytes_per_count",
          "scale_provenance",
          "dispatch_ids",
          "raw_counter_values",
          "measured_bytes",
          "relative_errors",
          "median_relative_error",
          "maximum_relative_error",
          "status"
        ],
        "properties": {
          "id": { "enum": ["read_reduce.read", "write.write", "copy.read", "copy.write"] },
          "operation": { "enum": ["read_reduce", "write", "copy"] },
          "direction": { "enum": ["read", "write"] },
          "counter_name": { "enum": ["GL2C_EA_RDREQ_DRAM_sum", "GCEA_WDRAM_SIZE_REQ_sum"] },
          "bytes_per_count": { "enum": [32, 128] },
          "scale_provenance": { "const": "empirical_known_byte_stream" },
          "dispatch_ids": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          },
          "raw_counter_values": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          },
          "measured_bytes": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          },
          "relative_errors": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "number", "minimum": 0 }
          },
          "median_relative_error": { "type": "number", "minimum": 0 },
          "maximum_relative_error": { "type": "number", "minimum": 0 },
          "status": { "enum": ["passed", "failed"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
