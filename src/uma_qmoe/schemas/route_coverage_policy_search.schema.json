{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uma-qmoe.local/schemas/route_coverage_policy_search.schema.json",
  "title": "UMA-QMoE RouteCoveragePolicySearch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "captured_at", "target_id", "status", "model", "method", "dataset", "calibration", "reference", "all_q4_baseline", "storage", "candidate_rows", "quality_gate", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "route_coverage_policy_search" },
    "captured_at": { "type": "string", "format": "date-time" },
    "target_id": { "enum": ["halo3", "spark1"] },
    "status": { "enum": ["passed", "failed"] },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_revision", "expert_pack_sha256"],
      "properties": {
        "model_id": { "const": "allenai/OLMoE-1B-7B-0125" },
        "model_revision": { "const": "9b0c1aa87e34a20052389dce1f0cf01da783f654" },
        "expert_pack_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "diagnostic_only", "materializes_expert_parameters", "performance_evidence", "coverage_thresholds", "source_policy_evidence", "prompt_fixture"],
      "properties": {
        "id": { "const": "per-layer-reference-route-coverage-bf16-v1" },
        "diagnostic_only": { "const": true },
        "materializes_expert_parameters": { "const": true },
        "performance_evidence": { "const": false },
        "coverage_thresholds": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "prefixItems": [{ "const": 0.5 }, { "const": 0.75 }, { "const": 0.9 }, { "const": 0.95 }, { "const": 0.99 }, { "const": 1.0 }],
          "items": false
        },
        "source_policy_evidence": { "$ref": "#/$defs/identity" },
        "prompt_fixture": { "$ref": "#/$defs/identity" }
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["calibration_sample_ids", "evaluation_sample_ids", "evaluation_prompt_token_count", "evaluation_target_token_count"],
      "properties": {
        "calibration_sample_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evaluation_sample_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evaluation_prompt_token_count": { "type": "integer", "minimum": 2 },
        "evaluation_target_token_count": { "type": "integer", "minimum": 2 }
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["route_counts_by_layer"],
      "properties": {
        "route_counts_by_layer": {
          "type": "array", "minItems": 16, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["layer_index", "expert_counts", "total_assignments"],
            "properties": {
              "layer_index": { "type": "integer", "minimum": 0, "maximum": 15 },
              "expert_counts": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "type": "integer", "minimum": 0 } },
              "total_assignments": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "reference": { "$ref": "#/$defs/reference" },
    "all_q4_baseline": { "$ref": "#/$defs/metrics" },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["all_q4_bytes", "total_expert_weight_count", "single_expert_extra_bytes"],
      "properties": {
        "all_q4_bytes": { "type": "integer", "minimum": 1 },
        "total_expert_weight_count": { "type": "integer", "minimum": 1 },
        "single_expert_extra_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "candidate_rows": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["policy_id", "mode", "coverage_threshold", "layers", "restored_expert_count", "metrics", "extra_bytes", "mixed_bytes", "effective_bpw", "finite"],
        "properties": {
          "policy_id": { "type": "string", "pattern": "^(coverage-(50|75|90|95|99|100)|all-experts)-bf16$" },
          "mode": { "enum": ["route_coverage", "all_experts"] },
          "coverage_threshold": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0.5, "maximum": 1.0 }] },
          "layers": {
            "type": "array", "minItems": 16, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["layer_index", "expert_ids", "assignment_coverage"],
              "properties": {
                "layer_index": { "type": "integer", "minimum": 0, "maximum": 15 },
                "expert_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 63 } },
                "assignment_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "restored_expert_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "metrics": { "$ref": "#/$defs/metrics" },
          "extra_bytes": { "type": "integer", "minimum": 1 },
          "mixed_bytes": { "type": "integer", "minimum": 1 },
          "effective_bpw": { "type": "number", "exclusiveMinimum": 0 },
          "finite": { "type": "boolean" }
        }
      }
    },
    "quality_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_relative_perplexity_increase", "minimum_router_exact_set_agreement", "first_passing_policy_id"],
      "properties": {
        "maximum_relative_perplexity_increase": { "const": 0.01 },
        "minimum_router_exact_set_agreement": { "const": 0.99 },
        "first_passing_policy_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(coverage-(50|75|90|95|99|100)|all-experts)-bf16$" }] }
      }
    },
    "gates": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_finite", "all_q4_finite", "dataset_split_disjoint", "calibration_complete", "candidate_progression", "matrix_finite", "all_experts_upper_bound", "quality_gate_unchanged", "overall_passed"],
      "properties": {
        "reference_finite": { "type": "boolean" },
        "all_q4_finite": { "type": "boolean" },
        "dataset_split_disjoint": { "type": "boolean" },
        "calibration_complete": { "type": "boolean" },
        "candidate_progression": { "type": "boolean" },
        "matrix_finite": { "type": "boolean" },
        "all_experts_upper_bound": { "type": "boolean" },
        "quality_gate_unchanged": { "type": "boolean" },
        "overall_passed": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["file_sha256", "semantic_sha256"], "properties": { "file_sha256": { "$ref": "#/$defs/sha256" }, "semantic_sha256": { "$ref": "#/$defs/sha256" } } },
    "reference": { "type": "object", "additionalProperties": false, "required": ["finite", "nll", "perplexity", "logits_sha256", "routes_sha256"], "properties": { "finite": { "type": "boolean" }, "nll": { "type": "number", "minimum": 0 }, "perplexity": { "type": "number", "minimum": 1 }, "logits_sha256": { "$ref": "#/$defs/sha256" }, "routes_sha256": { "$ref": "#/$defs/sha256" } } },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["finite", "nll", "perplexity", "relative_nll_change", "relative_perplexity_change", "top1_agreement", "logit_max_absolute_error", "logit_p99_absolute_error", "logit_cosine_similarity", "router_exact_set_agreement", "router_mean_set_overlap", "per_layer_router_exact_set_agreement"],
      "properties": {
        "finite": { "type": "boolean" }, "nll": { "type": "number", "minimum": 0 }, "perplexity": { "type": "number", "minimum": 1 },
        "relative_nll_change": { "type": "number" }, "relative_perplexity_change": { "type": "number" },
        "top1_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "logit_max_absolute_error": { "type": "number", "minimum": 0 }, "logit_p99_absolute_error": { "type": "number", "minimum": 0 },
        "logit_cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 },
        "router_exact_set_agreement": { "type": "number", "minimum": 0, "maximum": 1 }, "router_mean_set_overlap": { "type": "number", "minimum": 0, "maximum": 1 },
        "per_layer_router_exact_set_agreement": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    }
  }
}
